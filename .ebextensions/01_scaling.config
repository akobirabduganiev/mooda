option_settings:
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4

  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    Period: 60
    EvaluationPeriods: 2
    UpperThreshold: 70
    LowerThreshold: 30
    UpperBreachScaleIncrement: 1
    LowerBreachScaleIncrement: -1
    BreachDuration: 120
