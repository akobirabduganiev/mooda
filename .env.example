# Copy this file to `.env` and adjust values for your environment.
# IMPORTANT: Keep your real .env out of version control (add `.env` to .gitignore).

# Application
SPRING_PROFILES_ACTIVE=prod
PORT=8010
CORS_ALLOWED_ORIGINS=*

# Security
# Use a long, random string in production
JWT_SECRET=change-this-to-a-long-random-string

# PostgreSQL (container)
POSTGRES_DB=mooda_db
POSTGRES_USER=mooda
POSTGRES_PASSWORD=please-change-strong-password

# Database connection for the app (usually same as above)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mooda_db
DB_USER=mooda
DB_PASS=please-change-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
# Empty password for default Redis (no auth); set if you enable Redis auth
REDIS_PASSWORD=
